{
  "name": "repertorio-en-vivo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node node_modules/typescript/bin/tsc -b && node node_modules/vite/bin/vite.js build && node scripts/build-pwa.mjs",
    "preview": "node node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "start": "node server.mjs",
    "test": "node --test tests",
    "test:ui": "node scripts/test-ui.mjs",
    "test:lyrics-ui": "node scripts/test-lyrics-ui.mjs",
    "test:navigation-ui": "node scripts/test-navigation-ui.mjs",
    "test:mobile-add-ui": "node scripts/test-mobile-add-ui.mjs",
    "configure:sync": "node scripts/configure-sync.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@types/node": "22.16.5",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
